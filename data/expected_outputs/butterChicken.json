    {
      "instruction": "Slice one large red onion and roughly chop four to five tomatoes.",
      "duration_seconds": null
    },
    {
      "instruction": "Heat up oil in a pan and add in the garlic and onions and let that caramelize then add in your tomatoes and let that cook down until soft.",
